{
  "name": "openfun",
  "version": "0.1.0-alpha.37",
  "description": "An open-source AI game creation and runtime framework for generating an initial world and expanding it during play",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "openfun": "dist/cli.js"
  },
  "files": [
    "dist",
    "tools/blender/build.py",
    "tools/godot/*.gd",
    "docs/game-design/*.md",
    "tools/blender/LICENSE",
    "docs/runtime-protocol.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "format": "prettier --write src tests scripts package.json tsconfig*.json README.md README.zh-CN.md CONTRIBUTING.md docs",
    "format:check": "prettier --check src tests scripts package.json tsconfig*.json README.md README.zh-CN.md CONTRIBUTING.md docs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "node --import tsx tests/e2e/run.mjs",
    "test:live": "node --import tsx tests/live/run.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "context-mode": "1.0.169",
    "fflate": "0.8.2",
    "pi-mcp-adapter": "2.32.1",
    "typebox": "1.3.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
